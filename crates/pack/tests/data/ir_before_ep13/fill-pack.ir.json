{
  "format_version": 2,
  "pack": {
    "id": "fill-demo",
    "title": "差し込みの充填の試験用教材",
    "version": "0.0.1",
    "ir_format": 2,
    "guidance": "A"
  },
  "refs": [],
  "commands": {
    "deploy-all": "unsupported",
    "help": "builtin",
    "make-idea": "skill",
    "note": "builtin",
    "publish-run": "flow",
    "start-run": "flow",
    "sync-cloud": "unsupported",
    "vote": "builtin"
  },
  "views": {
    "v-files": {
      "kind": "file_tree"
    }
  },
  "fixtures": {},
  "hints": {},
  "rejections": {
    "rj-bad-arg-shape": {
      "category": "bad_arg_shape",
      "message": "「{{input_head|その操作}}」の引数の形が合っていません。",
      "next_action": "示された形で書き直して、もう一度送ります。（{{step_title}}）"
    },
    "rj-busy": {
      "category": "busy",
      "message": "「{{step_title}}」を処理中です。",
      "next_action": "あと {{remaining}} 回（全 {{total}} 回）で終わります。"
    },
    "rj-free-text-note": {
      "category": "free_text_unjudged",
      "message": "書いた内容の良し悪しは判定しません。（{{step_title}}）",
      "next_action": "自分の文を読み返します。"
    },
    "rj-miss-point": {
      "category": "not_in_this_step",
      "message": "そこではありません。",
      "next_action": "「{{step_title}}」で印のついた場所を指します。"
    },
    "rj-missing-arg": {
      "category": "missing_arg",
      "message": "「{{step_title}}」に必要な引数が足りません。",
      "next_action": "「{{step_title}}」の形に合わせて足し、もう一度送ります。"
    },
    "rj-not-in-this-step": {
      "category": "not_in_this_step",
      "message": "「{{input_head|その操作}}」は、この Step では使いません。",
      "next_action": "「{{step_title}}」の目的を読み直します。"
    },
    "rj-not-supported": {
      "category": "not_supported",
      "message": "「{{input_head|そのコマンド}}」は、この教材では扱いません。",
      "next_action": "教材の操作に戻ります。"
    },
    "rj-unknown-command": {
      "category": "unknown_command",
      "message": "「{{input_head|入力した語}}」は、この教材の一覧にありません。",
      "next_action": "「{{nearest_command|一覧にあるコマンド}}」に直して、もう一度送ります。"
    },
    "rj-wrong-answer-default": {
      "category": "not_in_this_step",
      "message": "選んだ答えは合いません。",
      "next_action": "「{{step_title}}」を読み直して、もう一度選びます。"
    },
    "rj-wrong-order": {
      "category": "wrong_order",
      "message": "「{{input_head|そのコマンド}}」を使うのは、まだ先です。",
      "next_action": "今の Step では、{{step_do}}。"
    },
    "rj-wrong-order-title": {
      "category": "wrong_order",
      "message": "「{{input_head|そのコマンド}}」を使うのは、まだ先です。",
      "next_action": "「{{step_title}}」の形に合わせて、もう一度送ります。"
    },
    "rj-wrong-own-1": {
      "category": "not_in_this_step",
      "message": "その答えだと前提が崩れます。",
      "next_action": "{{step_do}}。読み直して、もう一度選びます。"
    },
    "rj-wrong-own-2": {
      "category": "not_in_this_step",
      "message": "別の見方が要ります。（{{input_head|選択}}）",
      "next_action": "選択肢を読み比べて、もう一度選びます。"
    }
  },
  "clarifications": {
    "cl-ask": {
      "how_to_answer": "{{step_do}}。値を足して、もう一度送ります。",
      "message": "「{{step_title}}」に必要な値が足りません。"
    }
  },
  "defaults": {
    "bad_arg_shape": "rj-bad-arg-shape",
    "busy": "rj-busy",
    "free_text_unjudged": "rj-free-text-note",
    "missing_arg": "rj-missing-arg",
    "not_in_this_step": "rj-not-in-this-step",
    "not_supported": "rj-not-supported",
    "unknown_command": "rj-unknown-command",
    "wrong_order": "rj-wrong-order"
  },
  "instances": [
    {
      "id": "main",
      "args": {}
    }
  ],
  "nodes": [
    {
      "uid": "main/a",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "a",
        "title": "ヘルプを開く",
        "body": "a.md",
        "do": "/help を送ってコマンドの一覧を開く",
        "processing": [
          {
            "name": "p1-run"
          },
          {
            "name": "p2-run"
          },
          {
            "name": "p3-run"
          }
        ],
        "input": {
          "args": [
            {
              "name": "topic",
              "positional": true,
              "required": false,
              "shape": "kebab_case"
            }
          ],
          "kind": "command",
          "name": "help"
        },
        "rules": [
          {
            "id": "r-ask",
            "on": {
              "command": "help",
              "missing": [
                "topic"
              ]
            },
            "outcome": {
              "clarification": "cl-ask",
              "kind": "clarify"
            }
          },
          {
            "id": "r-help",
            "on": {
              "command": "help"
            },
            "outcome": {
              "effects": [
                {
                  "set_flag": "helped"
                }
              ],
              "kind": "accept"
            }
          }
        ],
        "confirm": {
          "kind": "none",
          "reason": "送った結果がそのまま次の Step の前提になるため、別の確認を置かない。"
        },
        "next": [
          {
            "to": "main/b"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの充填の試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/b",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "b",
        "title": "回数を決める",
        "body": "b.md",
        "input": {
          "args": [
            {
              "name": "run",
              "positional": true,
              "required": true,
              "shape": "digits"
            }
          ],
          "kind": "command",
          "name": "start-run"
        },
        "rules": [
          {
            "id": "r-start",
            "on": {
              "command": "start-run"
            },
            "outcome": {
              "effects": [
                {
                  "set_flag": "run-started"
                }
              ],
              "kind": "accept"
            }
          }
        ],
        "on_reject": {
          "wrong_order": "rj-wrong-order-title"
        },
        "confirm": {
          "kind": "none",
          "reason": "送った結果がそのまま次の Step の前提になるため、別の確認を置かない。"
        },
        "next": [
          {
            "to": "main/c"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの充填の試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/c",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "c",
        "title": "自分の言葉で書く",
        "body": "c.md",
        "do": "ここまでの感想を自分の言葉で書く",
        "processing": [
          {
            "name": "p1-run"
          },
          {
            "name": "p2-run"
          }
        ],
        "input": {
          "kind": "text",
          "max": 2000,
          "min": 1
        },
        "confirm": {
          "kind": "none",
          "reason": "書いた内容は判定せず、送ったことだけで先へ進むため、別の確認を置かない。"
        },
        "next": [
          {
            "to": "main/d"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの充填の試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/d",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "d",
        "title": "答えを選ぶ",
        "body": "d.md",
        "do": "いちばん近い答えを選ぶ",
        "input": {
          "kind": "choice",
          "options": [
            {
              "id": "opt-a",
              "label": "答え A"
            },
            {
              "id": "opt-b",
              "label": "答え B"
            },
            {
              "id": "opt-c",
              "label": "答え C"
            },
            {
              "id": "opt-d",
              "label": "答え D"
            }
          ]
        },
        "confirm": {
          "kind": "answer",
          "on_wrong": "rj-wrong-answer-default",
          "options": [
            {
              "correct": true,
              "id": "opt-a"
            },
            {
              "correct": false,
              "id": "opt-b",
              "on_wrong": "rj-wrong-own-1"
            },
            {
              "correct": false,
              "id": "opt-c",
              "on_wrong": "rj-wrong-own-2"
            },
            {
              "correct": false,
              "id": "opt-d"
            }
          ]
        },
        "next": [
          {
            "to": "main/e"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの充填の試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/e",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "e",
        "title": "場所を指す",
        "body": "e.md",
        "do": "変更された場所を指す",
        "views": [
          "v-files"
        ],
        "input": {
          "kind": "approval"
        },
        "confirm": {
          "kind": "point_at",
          "on_miss": "rj-miss-point",
          "targets": [
            {
              "path": "src/main.rs",
              "view": "v-files"
            }
          ]
        },
        "next": [
          {
            "to": "main/f"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [

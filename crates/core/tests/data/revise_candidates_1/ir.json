{
  "format_version": 1,
  "pack": {
    "id": "revise-candidates",
    "title": "直すの候補の試験",
    "version": "0.0.1",
    "ir_format": 1,
    "guidance": "A"
  },
  "rejections": {
    "rj-wrong-target": {
      "category": "not_in_this_step",
      "message": "その箇所には、曖昧な語がありません。",
      "next_action": "別の箇所を選びます。"
    },
    "rj-unfixed": {
      "category": "not_in_this_step",
      "message": "まだ直していません。",
      "next_action": "先に直す対象を選びます。"
    },
    "rj-override": {
      "category": "not_in_this_step",
      "message": "この Step 専用の拒否です。",
      "next_action": "次の行動です。"
    },
    "rj-default": {
      "category": "not_in_this_step",
      "message": "この Step では使いません。",
      "next_action": "今の Step の目的を読み直します。"
    }
  },
  "defaults": {
    "not_in_this_step": "rj-default"
  },
  "nodes": [
    {
      "uid": "main/st-cand",
      "scope": "main",
      "unit": "u",
      "step": {
        "id": "st-cand",
        "title": "候補つき",
        "input": {
          "kind": "approval",
          "revise": {
            "candidates": [
              {
                "id": "expect",
                "label": "期待する結果"
              },
              {
                "id": "reason",
                "label": "理由"
              },
              {
                "id": "scope"
              }
            ]
          }
        },
        "rules": [
          {
            "id": "r-revise-expect",
            "on": {
              "approval": "revise",
              "target": "expect"
            },
            "outcome": {
              "kind": "accept"
            }
          },
          {
            "id": "r-revise-other",
            "on": {
              "approval": "revise"
            },
            "outcome": {
              "kind": "reject",
              "rejection": "rj-wrong-target"
            }
          },
          {
            "id": "r-approve-early",
            "on": {
              "approval": "approve"
            },
            "outcome": {
              "kind": "reject",
              "rejection": "rj-unfixed"
            }
          }
        ],
        "next": [

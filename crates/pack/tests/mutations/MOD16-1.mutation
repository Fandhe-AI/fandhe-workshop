id: MOD16-1
package: fandhe-workshop-pack
test: round_instance_restore
target: crates/core/src/checkpoint.rs
find:     let mut run = crate::entry_derive::revert_owner(&state.run, &cp.run, &owner_root, &touched);
replace:     let mut run = crate::entry_derive::revert_owner(&state.run, &cp.run, &owner_root, &touched); let unit = |c: &Option<String>| ir.nodes.iter().find(|n| Some(&n.uid) == c.as_ref()).map(|n| n.unit.clone()); let own_unit = ir.instances.iter().find(|i| i.id == owner_root.0).and_then(|i| unit(&i.caller)); for i in &ir.instances { if i.id != owner_root.0 && own_unit.is_some() && unit(&i.caller) == own_unit { let r = crate::addr::Root(i.id.clone()); match cp.run.slices.get(&r) { Some(s) => { run.slices.insert(r, s.clone()); } None => { run.slices.remove(&r); } } } }
expect-fail: mod16_restore_in_round2_keeps_the_other_instance_progress
note: 復帰が同じ周回の別の実体の切り身まで写しへ戻す（周回単位の復帰。MOD-16 の否定）

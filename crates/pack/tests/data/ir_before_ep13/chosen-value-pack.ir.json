            }
          },
          {
            "id": "r-beta",
            "on": {
              "args": {
                "name": "beta"
              },
              "command": "make-item"
            },
            "outcome": {
              "effects": [
                {
                  "put": {
                    "attrs": {
                      "label": "second"
                    },
                    "path": "work/beta"
                  }
                }
              ],
              "kind": "accept"
            }
          }
        ],
        "confirm": {
          "kind": "none",
          "reason": "送った結果がそのまま次の Step の前提になるため、別の確認を置かない。"
        },
        "next": [
          {
            "to": "main/b"
          }
        ]
      },

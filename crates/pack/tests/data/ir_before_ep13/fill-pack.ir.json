                "text": "差し込みの充填の試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/f",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "f",
        "title": "承認する",
        "body": "f.md",
        "do": "結果を読んで承認する",
        "final": true,
        "input": {
          "kind": "approval"
        },
        "confirm": {
          "kind": "approve"
        }
      },
      "body_doc": {
        "version": 1,

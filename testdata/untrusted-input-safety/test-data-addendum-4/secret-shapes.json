{
  "note": "手順 9 の試験データの機械可読版。test-data/secret-like.md の表（固定済み）と同じ部品を、そのまま JSON にした。完成した値はどこにも書かない。試験のとき、道具が parts を空文字で連結し、{N×c} と {seqN} を展開して入力する。expect は警告に出る形の ID（実装が返す）。",
  "expand": {
    "N×c": "文字 c を N 個並べる",
    "seqN": "0123456789abcdefghijklmnopqrstuvwxyz を先頭から N 文字",
    "\\n": "改行 1 つ"
  },
  "shapes": [
    { "id": "S-01", "expect": "github_token", "parts": ["ghp", "_", "{seq36}"] },
    { "id": "S-02", "expect": "github_pat", "parts": ["github", "_pat_", "{22×A}_{59×B}"] },
    { "id": "S-03", "expect": "slack_token", "parts": ["xox", "b-", "{12×1}-{12×2}-{24×a}"] },
    { "id": "S-04", "expect": "aws_access_key", "parts": ["AK", "IA", "{16×Z}"] },
    { "id": "S-05", "expect": "aws_secret_key", "parts": ["aws_secret_access_key=", "", "{40×k}"] },
    { "id": "S-06", "expect": "stripe_live_key", "parts": ["sk", "_live_", "{24×0}"] },
    { "id": "S-07", "expect": "google_api_key", "parts": ["AI", "za", "{35×x}"] },
    { "id": "S-08", "expect": "jwt", "parts": ["eyJ", "hbGciOiJIUzI1NiJ9.eyJzdWIiOiJkdW1teSJ9.", "{43×_}"] },
    { "id": "S-09", "expect": "private_key", "parts": ["-----BEGIN ", "PRIVATE KEY-----\\n{64×A}\\n-----END ", "PRIVATE KEY-----"] },
    { "id": "S-10", "expect": "connection_string", "parts": ["postgres", "://user:", "{16×p}@db.example.invalid:5432/app"] }
  ],
  "controls": [
    { "id": "N-01", "text": "ghp という略語の説明です" },
    { "id": "N-02", "text": "今日は掲示板の教材で、ログインした人だけが書き込める仕組みを順番に確かめていきます。ここまでの流れを短くまとめて、次の Step に進みます。" }
  ],
  "extra_controls": [
    { "id": "N-03", "text": "https://example.invalid/docs?page=2 を開いて読みます" },
    { "id": "N-04", "text": "/new-idea bbs-with-login" },
    { "id": "N-05", "text": "sk_live_ という接頭辞だけの説明です。AKIA で始まる形があります" },
    { "id": "N-06", "text": "ssh://git@example.invalid/repo.git に接続します" }
  ]
}

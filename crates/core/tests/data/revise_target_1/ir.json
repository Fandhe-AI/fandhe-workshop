{
  "format_version": 1,
  "pack": { "id": "revise-target", "title": "直すの対象の試験", "version": "0.0.1", "ir_format": 1, "guidance": "A" },
  "rejections": {
    "rj-2-6-wrong-target": {
      "category": "not_in_this_step",
      "message": "直す対象を選んでください。",
      "next_action": "{{step_do}} 直す対象のボタンを押します。"
    },
    "rj-early": {
      "category": "not_in_this_step",
      "message": "まだ承認できません。",
      "next_action": "先に、直す対象を選びます。"
    },
    "rj-default-not-in-this-step": {
      "category": "not_in_this_step",
      "message": "この Step では使いません。",
      "next_action": "今の Step の目的を読み直し、ヒントを開きます。"
    },
    "rj-override": {
      "category": "not_in_this_step",
      "message": "この Step 専用の拒否です。",
      "next_action": "この Step 専用の次の行動です。"
    },
    "rj-blank": {
      "category": "not_in_this_step",
      "message": "次の行動が空白だけです。",
      "next_action": "   "
    },
    "rj-free": {
      "category": "free_text_unjudged",
      "message": "判定しません。",
      "next_action": "自分で読み返します。"
    },
    "rj-no-next": {
      "category": "not_in_this_step",
      "message": "次の行動がありません。"
    }
  },
  "defaults": { "not_in_this_step": "rj-default-not-in-this-step" },
  "nodes": [
    {
      "uid": "main/st-26", "scope": "main", "unit": "u",
      "step": {
        "id": "st-26", "title": "ST-2.6 型",
        "input": { "kind": "approval" },
        "rules": [
          { "id": "r-revise-expect", "on": { "approval": "revise", "target": "expect" }, "outcome": { "kind": "accept" } },
          { "id": "r-revise-other", "on": { "approval": "revise" }, "outcome": { "kind": "reject", "rejection": "rj-2-6-wrong-target" } },
          { "id": "r-approve-early", "on": { "approval": "approve" }, "outcome": { "kind": "reject", "rejection": "rj-early" } }
        ]
      }
    },
    {
      "uid": "main/st-two", "scope": "main", "unit": "u",
      "step": {
        "id": "st-two", "title": "対象が 2 つ",
        "input": { "kind": "approval" },
        "rules": [
          { "id": "r-expect", "on": { "approval": "revise", "target": "expect" }, "outcome": { "kind": "accept" } },
          { "id": "r-reason", "on": { "approval": "revise", "target": "reason" }, "outcome": { "kind": "accept" } },
          { "id": "r-expect-again", "on": { "approval": "revise", "target": "expect" }, "outcome": { "kind": "accept" } },
          { "id": "r-approve", "on": { "approval": "approve" }, "outcome": { "kind": "accept" } }
        ]
      }
    },
    {
      "uid": "main/st-mixed", "scope": "main", "unit": "u",
      "step": {
        "id": "st-mixed", "title": "矛盾した教材",
        "input": { "kind": "approval" },
        "rules": [
          { "id": "r-expect", "on": { "approval": "revise", "target": "expect" }, "outcome": { "kind": "accept" } },
          { "id": "r-bare-accept", "on": { "approval": "revise" }, "outcome": { "kind": "accept" } },
          { "id": "r-bare-clarify", "on": { "approval": "revise" }, "outcome": { "kind": "clarify", "clarification": "cl-x" } }
        ]
      }
    },
    {
      "uid": "main/st-23", "scope": "main", "unit": "u",
      "step": {
        "id": "st-23", "title": "ST-2.3 型",
        "input": { "kind": "approval" },
        "rules": [
          { "id": "r-hold", "on": { "approval": "revise" }, "outcome": { "kind": "accept" } },
          { "id": "r-approve", "on": { "approval": "approve" }, "outcome": { "kind": "accept" } }
        ]
      }
    },
    {
      "uid": "main/st-override", "scope": "main", "unit": "u",
      "step": {
        "id": "st-override", "title": "on_reject で上書き",
        "input": { "kind": "approval" },
        "rules": [
          { "id": "r-expect", "on": { "approval": "revise", "target": "expect" }, "outcome": { "kind": "accept" } }
        ],
        "on_reject": { "not_in_this_step": "rj-override" }
      }
    },
    {
      "uid": "main/st-broken-text", "scope": "main", "unit": "u",
      "step": {
        "id": "st-broken-text", "title": "文面が壊れている",
        "input": { "kind": "approval" },
        "rules": [
          { "id": "r-expect", "on": { "approval": "revise", "target": "expect" }, "outcome": { "kind": "accept" } }
        ],
        "on_reject": { "not_in_this_step": "rj-blank" }
      }
    }
  ],
  "starts": []
}

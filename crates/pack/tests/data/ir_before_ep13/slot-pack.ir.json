{
  "format_version": 2,
  "pack": {
    "id": "slot-demo",
    "title": "差し込みの枠の試験用教材",
    "version": "0.0.1",
    "ir_format": 2,
    "guidance": "A"
  },
  "refs": [],
  "commands": {
    "help": "builtin"
  },
  "views": {},
  "fixtures": {},
  "hints": {},
  "rejections": {
    "rj-bad-arg-shape": {
      "category": "bad_arg_shape",
      "message": "引数の形が合っていません。",
      "next_action": "示された形で書き直して、もう一度送ります。"
    },
    "rj-busy": {
      "category": "busy",
      "message": "「{{step_title}}」を処理中です。",
      "next_action": "あと {{remaining}} 回（全 {{total}} 回）で終わります。終わると、次の入力を受け付けます。"
    },
    "rj-free-text-note": {
      "category": "free_text_unjudged",
      "message": "書いた内容の良し悪しは、この教材では判定しません。",
      "next_action": "自分の文を、自分で読み返します。"
    },
    "rj-missing-arg": {
      "category": "missing_arg",
      "message": "必要な引数が足りません。",
      "next_action": "「{{step_title}}」の形に合わせて足し、もう一度送ります。"
    },
    "rj-not-in-this-step": {
      "category": "not_in_this_step",
      "message": "「{{input_head|その操作}}」は、この Step では使いません。",
      "next_action": "今の Step の目的を読み直します。"
    },
    "rj-not-supported": {
      "category": "not_supported",
      "message": "実際の環境ではできますが、この教材では扱いません。",
      "next_action": "教材の操作に戻ります。"
    },
    "rj-unknown-command": {
      "category": "unknown_command",
      "message": "「{{input_head|入力した語}}」は、この教材の一覧にありません。",
      "next_action": "「{{nearest_command|/help}}」に直して、もう一度送ります。"
    },
    "rj-wrong-order": {
      "category": "wrong_order",
      "message": "「{{input_head|そのコマンド}}」を使うのは、まだ先です。",
      "next_action": "今の Step では、{{step_do}}。"
    }
  },
  "clarifications": {
    "cl-ask": {
      "how_to_answer": "{{step_do}}。値を足して、もう一度送ります。",
      "message": "「{{step_title}}」に必要な値が足りません。"
    }
  },
  "defaults": {
    "bad_arg_shape": "rj-bad-arg-shape",
    "busy": "rj-busy",
    "free_text_unjudged": "rj-free-text-note",
    "missing_arg": "rj-missing-arg",
    "not_in_this_step": "rj-not-in-this-step",
    "not_supported": "rj-not-supported",
    "unknown_command": "rj-unknown-command",
    "wrong_order": "rj-wrong-order"
  },
  "instances": [
    {
      "id": "main",
      "args": {}
    }
  ],
  "nodes": [
    {
      "uid": "main/a",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "a",
        "title": "ヘルプを開く",
        "body": "a.md",
        "do": "/help を送ってコマンドの一覧を開く",
        "input": {
          "args": [
            {
              "name": "topic",
              "positional": true,
              "required": false,
              "shape": "kebab_case"
            }
          ],
          "kind": "command",
          "name": "help"
        },
        "rules": [
          {
            "id": "r-ask",
            "on": {
              "command": "help",
              "missing": [
                "topic"
              ]
            },
            "outcome": {
              "clarification": "cl-ask",
              "kind": "clarify"
            }
          },
          {
            "id": "r-help",
            "on": {
              "command": "help"
            },
            "outcome": {
              "effects": [
                {
                  "set_flag": "helped"
                }
              ],
              "kind": "accept"
            }
          }
        ],
        "confirm": {
          "kind": "none",
          "reason": "送った結果がそのまま次の Step の前提になるため、別の確認を置かない。"
        },
        "next": [
          {
            "to": "main/b"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/b",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "b",
        "title": "自分の言葉で書く",
        "body": "b.md",
        "do": "ここまでの感想を自分の言葉で書く",
        "input": {
          "kind": "text",
          "max": 2000,
          "min": 1
        },
        "confirm": {
          "kind": "none",
          "reason": "書いた内容は判定せず、送ったことだけで先へ進むため、別の確認を置かない。"
        },
        "next": [
          {
            "to": "main/c"
          }
        ]
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    },
    {
      "uid": "main/c",
      "scope": "main",
      "unit": "c1",
      "step": {
        "id": "c",
        "title": "おわり",
        "body": "c.md",
        "final": true
      },
      "body_doc": {
        "version": 1,
        "blocks": [
          {
            "t": "paragraph",
            "children": [
              {
                "t": "text",
                "text": "差し込みの試験用の本文（表示には使わない）。"
              }
            ]
          }
        ]
      }
    }
  ],
  "starts": [
    {
      "id": "s1",
      "node": "main/a",
      "effects": []
    },
    {
      "id": "s2",
      "node": "main/b",
      "effects": []
    }
  ]
}

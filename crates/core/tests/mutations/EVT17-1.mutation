id: EVT17-1
package: fandhe-workshop-core
test: fast_forward
target: crates/core/src/recorded_session.rs
find:         self.apply(op).to_vec()
replace:         self.session.apply(op).to_vec()
expect-fail: fast_forward_records_same_ops
